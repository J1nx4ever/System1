						<Name><![CDATA[density1]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[siteId = id;
siteName = name;
isOre = oreFlag;
grade = g;
remainingTons = remain;
singleServeTime = svcTime;
bucket = bucket1;
density = density1;

available = true;
incomingTrucks = 0;
busy = false;
xPos = xPos;
yPos = yPos;
producedTons = 0.0;
totalServiceTime = 0.0;]]></Body>
				</Function>
