	<ActiveObjectClasses>
		<!--   =========   Active Object Class   ========  -->
		<ActiveObjectClass>
			<Id>1776755236910</Id>
			<Name><![CDATA[Main]]></Name>
			<Import><![CDATA[import DRL.grpc.*;
import Fusion.grpc.StateData;
import Fusion.client.SpeedInferenceClient;
import Fusion.grpc.ObservationDict;
import Fusion.grpc.ActionDict;
import Fusion.grpc.StepResponse;
import io.grpc.Server;
import io.grpc.ServerBuilder;
import io.grpc.stub.StreamObserver;
import mine.field.v1.*;
import org.eclipse.paho.client.mqttv3.*;]]></Import>
			<StartupCode><![CDATA[init1();
initRoadPointNodeMap();
init_network();
init_routeNodeMap();
startFieldMqtt();
if (numTrucks <= 0) {
    throw new IllegalStateException("numTrucks must be > 0");
}
if (targetOreTons2h <= 0 || targetOreTonsShift <= 0) {
    throw new IllegalStateException("Invalid production target");
}
if (Math.abs(targetGrade - 0.25) > 1e-9) {
    throw new IllegalStateException(
        "dispatch.v1-27 requires targetGrade=0.25"
    );
}
episodeId = java.util.UUID.randomUUID().toString();
decisionSequence = 0;
episodeStarted = false;
episodeClosed = false;
previousAction = -1;

currentWindowIndex = 0;
windowOreTons = 0;
windowMetalTons = 0;

pendingGradeActionReward = 0;
pendingGrade2hReward = 0;
pendingGradeShiftReward = 0;
pendingProductionReward = 0;
if (enableOnnxDispatch) {
    rlClient = new RLClient(dispatchInferenceHost, dispatchInferencePort, dispatchInferenceTimeoutMs);
}
if (enableSpeedInference) {
    speedInferenceClient = new SpeedInferenceClient(
        speedInferenceHost,
        speedInferencePort,
        speedInferenceTimeoutMs
    );
}
lastWaitVehicleSeconds = getCumulativeWaitVehicleSeconds();
lastDecisionTimeSec = time(SECOND);
for(Truck t: trucks){
    traceln(
       t.getName()
       +" id="
       +t.truckId
    );
    traceln(
		"truck="+t.getName()
		+" x="+t.getX()
		+" y="+t.getY()
	);	
}]]></StartupCode>
			<DestroyCode><![CDATA[if (rlClient != null) {
    rlClient.shutdown();
}
try {
    if (fieldClient != null) {
        if (fieldClient.isConnected()) fieldClient.disconnect().waitForCompletion(3000);
        fieldClient.close();
    }
} catch (Exception e) {
    traceln("[FieldMQTT] shutdown: " + e.getMessage());
}
]]></DestroyCode>
