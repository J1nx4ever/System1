							<Name><![CDATA[forceStatisticsCollection]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Truck t = (Truck) agent;
t.isWaitingForDumpResource = false;
t.executionPhase = "DUMPING";
numInDumpService++;

t.dumpServiceStartTime = time();
if (t.productionCycleId != null) main.emitProductionEvent(t, "DUMP_START", siteId);
double waitTime = t.dumpServiceStartTime - t.dumpQueueEnterTime;
if (waitTime < 0) waitTime = 0;

t.lastDumpWaitTime = waitTime;
t.totalDumpWaitTime += waitTime;

totalDumpQueueTime += waitTime;

main.totalSystemDumpWaitTime += waitTime;
main.totalWaitTime += waitTime;

/*traceln("Truck " + t.truckId
    + " starts dumping at " + siteName
    + ", dumpWaitTime=" + waitTime
    + ", totalDumpQueueTime=" + totalDumpQueueTime
    + ", systemWait=" + main.totalWaitTime
    + ", waitingForDump=" + seizeDump.size()
    + ", dumping=" + numInDumpService);*/]]></Code>
							</Value>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onAtExit]]></Name>
						</Parameter>
						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Truck t = (Truck) agent;

numInDumpService = Math.max(0, numInDumpService - 1);

t.dumpServiceEndTime = time();

double serviceTime = t.dumpServiceEndTime - t.dumpServiceStartTime;
if (serviceTime < 0) serviceTime = 0;

totalDumpServiceTime += serviceTime;

/*traceln("Truck " + t.truckId
    + " finishes dumping at " + siteName
    + ", dumpServiceTime=" + serviceTime
    + ", totalDumpServiceTime=" + totalDumpServiceTime
    + ", dumping=" + numInDumpService);*/]]></Code>
							</Value>
						</Parameter>
