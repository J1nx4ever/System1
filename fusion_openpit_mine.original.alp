				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783414289948</Id>
					<Name><![CDATA[getCurrentSegmentIndex]]></Name>
					<X>1780</X><Y>-760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null || t.currentSegment == null || t.currentRouteSegments == null) {
    return -1;
}

for (int i = 0; i < t.currentRouteSegments.size(); i++) {
    PathSegment seg = t.currentRouteSegments.get(i);

    if (seg == null) {
        continue;
    }

    if (seg.isSameDirectedSegment(t.currentSegment)) {
        return i;
    }
}

return -1;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783476220222</Id>
					<Name><![CDATA[clearConflictState]]></Name>
					<X>1770</X><Y>-580</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null) {
    return;
}

if (t.conflict_id == null) {
    t.conflict_id = new java.util.ArrayList<Integer>();
} else {
    t.conflict_id.clear();
}

if (t.conflictSpeed == null) {
    t.conflictSpeed = new java.util.ArrayList<Float>();
} else {
    t.conflictSpeed.clear();
}

if (t.conflictEta == null) {
    t.conflictEta = new java.util.ArrayList<Float>();
} else {
    t.conflictEta.clear();
}

if (t.conflictDist == null) {
    t.conflictDist = new java.util.ArrayList<Float>();
} else {
    t.conflictDist.clear();
}

t.conflictNodeKey = "";
t.egoConflictEta = 9999;
t.egoConflictDist = 9999;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783476381474</Id>
					<Name><![CDATA[getTruckConflictNodeKey]]></Name>
					<X>1770</X><Y>-550</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null) {
    return "";
}

// 优先用 currentSegment 的有向终点
try {
    if (t.currentSegment != null && t.currentSegment.getDirectedTo() != null) {
        return t.currentSegment.getDirectedTo();
    }
} catch (Exception e) {}

// 如果没有 getDirectedTo()，直接用 to
try {
    if (t.currentSegment != null && t.currentSegment.to != null) {
        return t.currentSegment.to;
    }
} catch (Exception e) {}

return "";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783476526373</Id>
					<Name><![CDATA[calcDistanceToNode]]></Name>
					<X>1770</X><Y>-520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[nodeKey]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (t == null || nodeKey == null || nodeKey.length() == 0) {
    return 9999.0;
}

// 当前路段下游节点正是待计算节点时，使用沿路网的剩余距离。
// 这与训练 ALP 中 get_distance() 的语义最接近。
try {
    if (t.currentSegment != null
        && t.currentSegment.getDirectedTo() != null
        && nodeKey.equals(t.currentSegment.getDirectedTo())) {

        double distance = t.disToInt;
        if (Double.isFinite(distance) && distance >= 0.0) {
            return distance;
        }
    }
} catch (Exception e) {
    // 继续使用下面的几何距离兜底。
}

try {
    com.anylogic.engine.markup.PointNode node = getRoadPointNode(nodeKey);
    if (node == null) return 9999.0;

    double distance = DistanceRecorder(
        t.getX(), t.getY(),
        node.getX(), node.getY()
    );

    if (!Double.isFinite(distance) || distance < 0.0) {
        return 9999.0;
    }

    return distance;
} catch (Exception e) {
    traceln(
        "[Conflict] calcDistanceToNode failed: truck="
        + t.truckId + ", node=" + nodeKey
        + ", error=" + e.getMessage()
    );
    return 9999.0;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783476683760</Id>
					<Name><![CDATA[calcEta]]></Name>
					<X>1770</X><Y>-490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[dist]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[speed]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (dist >= 9999) {
    return 9999;
}

if (speed <= 0.1) {
    return 9999;
}

return dist / speed;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783832120324</Id>
					<Name><![CDATA[selectNextLoadSiteAI2]]></Name>
					<X>660</X><Y>-720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[// 1. 调用 Main 里的函数，打包当前这辆车的 28 维状态
Observation currentObs = buildObservation(t);

// 2. 将状态塞入通信请求包 (DispatchRequest)
DispatchRequest request = DispatchRequest.newBuilder()
    .setTruckId(t.truckId)
    .setObs(currentObs)
    .build();

// ========================================================
// 3. 传递向量，并阻塞等待 Python 大脑返回消息！
//    注意：执行到这里时，AnyLogic 的仿真时间会瞬间静止，
//    直到 Python 算出了结果，时间才会继续流逝。
// ========================================================
int id =  rlClient.getNextDestination(request);
traceln("前往LoadSite:" + id );
return id;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1783842936574</Id>
					<Name><![CDATA[buildFrontendStateJson]]></Name>
					<X>1910</X><Y>-240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[String simId = "SIM_001";

double currentSimTime = time(SECOND);

String currentStatus = "RUNNING";


// ==============================
// Trucks
// 旧接口格式
// truckId保持int
// ==============================

StringBuilder trucksBuilder = new StringBuilder("[");

for(int i=0;i<trucks.size();i++){

    Truck truck = trucks.get(i);

    if(i>0){
        trucksBuilder.append(",");
    }


    trucksBuilder.append(

        String.format(
        java.util.Locale.US,

        "{"

        +"\"truckId\":%d,"

        +"\"x\":%.6f,"

        +"\"y\":%.6f,"

        +"\"state\":\"%s\","

        +"\"target\":\"%s\","

        +"\"speed\":%.6f,"

        +"\"payload\":%.6f"

        +"}",


        // 保留旧int
        truck.truckId,


        truck.getX(),

        truck.getY(),


        // 当前状态
        truck.debugLastAction,


        // 这里可以暂时保持旧名字
        truck.targetNodeName,


        truck.getSpeed(MPS),


        // 当前实际载荷
        truck.payloadTons

        )
    );
}


trucksBuilder.append("]");


String trucksJson =
trucksBuilder.toString();



// ==============================
// LoadSite / Shovel
// 旧格式
// ==============================


StringBuilder shovelsBuilder =
new StringBuilder("[");


for(int i=0;i<loadSites.size();i++){

    LoadSite loadSite =
    loadSites.get(i);


    if(i>0){
        shovelsBuilder.append(",");
    }


    shovelsBuilder.append(

        String.format(
        java.util.Locale.US,

        "{"

        +"\"shovelId\":\"%s\","

        +"\"queueLength\":%d,"

        +"\"available\":%s,"

        +"\"grade\":%.6f,"

        +"\"remainingTonnage\":%.6f"

        +"}",


        loadSite.siteName,


        loadSite.queue.size(),


        Boolean.toString(
            loadSite.available
            &&
            !loadSite.busy
        ),


        loadSite.grade,


        loadSite.remainingTons

        )
    );
}


shovelsBuilder.append("]");


String shovelsJson =
shovelsBuilder.toString();



// ==============================
// KPI
// ==============================

double oreTonnage =
crusherOreTons;


double wasteTonnage =
totalWasteMoved;


double totalTonnage =
oreTonnage+wasteTonnage;


double gradeDeviation =
abs(gradeGap);


double totalWaitingTime =
totalWaitTime;



String kpiJson =

String.format(
java.util.Locale.US,

"{"

+"\"oreTonnage\":%.6f,"

+"\"wasteTonnage\":%.6f,"

+"\"totalTonnage\":%.6f,"

+"\"gradeDeviation\":%.6f,"

+"\"totalWaitingTime\":%.6f"

+"}",


oreTonnage,

wasteTonnage,

totalTonnage,

gradeDeviation,

totalWaitingTime

);



// ==============================
// lastDispatch
// 保留旧格式
// 但是填真实PPO结果
// ==============================


String lastDispatchJson =
    "{"
        + "\"requestId\":\"" + lastDecisionId + "\","
        + "\"truckId\":" + lastDispatchTruckId + ","
        + "\"modelVersion\":\"" + lastDecisionModel + "\","
        + "\"rawAction\":" + rawAction + ","
        + "\"executedAction\":" + executedAction + ","
        + "\"value\":" + lastDecisionValue + ","
        + "\"logits\":" + lastDecisionLogits.toString() + ","
        + "\"maskApplied\":false,"
        + "\"fallbackUsed\":" + fallbackUsed + ","
        + "\"latencyUs\":" + inferenceLatencyUs + ","
        + "\"provider\":\"TensorrtExecutionProvider\","
        + "\"errorCode\":\"OK\""
    + "}";



// ==============================
// Final
// ==============================


return String.format(

java.util.Locale.US,

"{"

+"\"simId\":\"%s\","

+"\"simTime\":%.6f,"

+"\"status\":\"%s\","

+"\"trucks\":%s,"

+"\"shovels\":%s,"

+"\"kpi\":%s,"

+"\"lastDispatch\":%s"

+"}",


simId,

currentSimTime,

currentStatus,

trucksJson,

shovelsJson,

kpiJson,

lastDispatchJson

);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783842972829</Id>
					<Name><![CDATA[reportStateToBackend]]></Name>
					<X>1910</X><Y>-210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    String requestJson = buildFrontendStateJson();

    java.net.http.HttpRequest request =
        java.net.http.HttpRequest.newBuilder()
            .uri(
                java.net.URI.create(
                    "http://localhost:8080/api/simulation/state"
                )
            )
            .timeout(java.time.Duration.ofSeconds(5))
            .header("Content-Type", "application/json")
            .header("Accept", "application/json")
            .POST(
                java.net.http.HttpRequest.BodyPublishers.ofString(
                    requestJson,
                    java.nio.charset.StandardCharsets.UTF_8
                )
            )
            .build();

    /*
     * 使用异步请求，避免 HTTP 请求阻塞 AnyLogic 仿真线程。
     *
     * 网络异常或后端未启动时，只打印错误，不抛出到仿真主流程。
     */
    frontendStateHttpClient
        .sendAsync(
            request,
            java.net.http.HttpResponse.BodyHandlers.ofString(
                java.nio.charset.StandardCharsets.UTF_8
            )
        )
        .whenComplete((response, throwable) -> {
            try {
                if (throwable != null) {
                    traceln(
                        "[StateReport] HTTP request failed: "
                        + throwable.getMessage()
                    );
                    return;
                }

                int statusCode = response.statusCode();

                if (statusCode < 200 || statusCode >= 300) {
                    traceln(
                        "[StateReport] Backend returned HTTP "
                        + statusCode
                        + ", response body: "
                        + response.body()
                    );
                }

                /*
                 * 调试阶段可打开下面的日志。
                 * 正式运行时建议关闭，避免每秒输出一条日志。
                 */
                // else {
                //     traceln(
                //         "[StateReport] State reported successfully, HTTP "
                //         + statusCode
                //     );
                // }

            } catch (Exception callbackException) {
                /*
                 * 回调函数中的异常同样不允许中断仿真。
                 */
                traceln(
                    "[StateReport] Response callback error: "
                    + callbackException.getMessage()
                );
            }
        });

} catch (Exception exception) {
    /*
     * JSON 构建、URI 创建或 HTTP 请求创建失败时，
     * 仅记录错误，不中断 AnyLogic 仿真。
     */
    traceln(
        "[StateReport] Failed to report simulation state: "
        + exception.getMessage()
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1785480216924</Id>
					<Name><![CDATA[escapeFrontendJson]]></Name>
					<X>2140</X><Y>-270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[value]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (value == null) {
    return "";
}

return value
    .replace("\\", "\\\\")
    .replace("\"", "\\\"")
    .replace("\b", "\\b")
    .replace("\f", "\\f")
    .replace("\n", "\\n")
    .replace("\r", "\\r")
    .replace("\t", "\\t");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1785650274480</Id>
					<Name><![CDATA[buildLayoutJson]]></Name>
					<X>2620</X><Y>-250</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[

StringBuilder sb=new StringBuilder();


sb.append("{");
sb.append("\"layoutId\":\"openpit-layout-01\",");
sb.append("\"width\":1920,");
sb.append("\"height\":957,");


sb.append("\"devices\":[");


for(int i=0;i<layoutEntities.size();i++){

    LayoutEntity e=layoutEntities.get(i);


    sb.append("{");

    sb.append("\"id\":\"")
      .append(e.id)
      .append("\",");


    sb.append("\"type\":\"")
      .append(e.type)
      .append("\",");


    sb.append("\"x\":")
      .append(e.x)
      .append(",");


    sb.append("\"y\":")
      .append(e.y);


    sb.append("}");


    if(i<layoutEntities.size()-1)
        sb.append(",");

}


sb.append("]}");


return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790214623784</Id>
					<Name><![CDATA[applyInferenceAccelerations]]></Name>
					<X>1260</X><Y>-540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[actions]]></Name>
						<Type><![CDATA[ActionDict]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[dt]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (actions == null) return;

for (Fusion.grpc.Action action : actions.getActionsList()) {
    if (action == null || action.getActionCount() < 1) continue;

    String agentId = action.getAgentId();
    if (agentId == null || agentId.length() == 0) continue;

    int truckId;
    try {
        truckId = Integer.parseInt(agentId.replace("agent_", ""));
    } catch (Exception e) {
        traceln("[SpeedInference] invalid agent id: " + agentId);
        continue;
    }

    double acceleration = action.getAction(0);
    if (!Double.isFinite(acceleration)) {
        traceln(
            "[SpeedInference] invalid acceleration: agent="
            + agentId + ", value=" + acceleration
        );
        continue;
    }

    // checkpoint 的连续动作范围。
    acceleration = Math.max(-3.0, Math.min(2.0, acceleration));

    for (Truck t : trucks) {
        if (t == null || t.truckId != truckId) continue;

        // 与训练 execute_actions() 的历史动作更新顺序一致。
        t.prevCmdAccel = t.cmdAccel;
        t.cmdAccel = acceleration;

        double currentSpeedMps;
        try {
            currentSpeedMps = t.getSpeed();
        } catch (Exception e) {
            currentSpeedMps = t.egoSpeed;
        }

        if (!Double.isFinite(currentSpeedMps) || currentSpeedMps < 0.0) {
            currentSpeedMps = 0.0;
        }

        double nextSpeedMps =
            currentSpeedMps + acceleration * dt;

        

		// 与原训练 ALP 一致：速度不能降到 0
		final double minSpeedMps = 1e-5;
		final double maxSpeedMps = 8;
		
		nextSpeedMps = Math.max(
		    minSpeedMps,
		    Math.min(maxSpeedMps, nextSpeedMps)
		);

        try {
            t.setSpeed(nextSpeedMps, MPS);
        } catch (Exception e) {
            t.setSpeed(nextSpeedMps);
        }

        t.egoSpeed = nextSpeedMps;
        break;
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790338700304</Id>
					<Name><![CDATA[startFieldMqtt]]></Name>
					<X>1025</X><Y>-1155</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    fieldClient = new org.eclipse.paho.client.mqttv3.MqttAsyncClient(
        fieldBrokerUri,
        "anylogic-" + fieldSimId,
        new org.eclipse.paho.client.mqttv3.persist.MemoryPersistence()
    );

    org.eclipse.paho.client.mqttv3.MqttConnectOptions options =
        new org.eclipse.paho.client.mqttv3.MqttConnectOptions();
    options.setAutomaticReconnect(true);
    options.setCleanSession(true);
    options.setMaxInflight(1000);
    options.setUserName("field_uplink");

    String mqttPassword = System.getenv("FIELD_MQTT_PASSWORD");
    if (mqttPassword == null || mqttPassword.isEmpty()) {
        throw new IllegalStateException("FIELD_MQTT_PASSWORD environment variable is not set");
    }
    options.setPassword(mqttPassword.toCharArray());

    fieldClient.setCallback(new org.eclipse.paho.client.mqttv3.MqttCallbackExtended() {
        public void connectComplete(boolean reconnect, String serverURI) {
            try {
					fieldClient.subscribe(
					    new String[] {
					        "mine/sim/" + fieldSimId + "/command/manual-dispatch/+",
					        "mine/sim/" + fieldSimId + "/command/auto-dispatch/+",
					        "mine/sim/" + fieldSimId + "/command/speed/+",
					        "mine/sim/" + fieldSimId + "/terminal/+/+/message"
					    },
					    new int[] { 1, 1, 1, 1 }
					).waitForCompletion(5000);
					fieldMapPublished = false;
					traceln("[DecisionGateway] command subscriptions ready");
            } catch (Exception e) {
                traceln("[ManualDispatch] subscribe failed: " + e.getMessage());
            }
        }

        public void connectionLost(Throwable cause) {
            traceln("[FieldMQTT] connection lost: " +
                (cause == null ? "unknown" : cause.getMessage()));
        }

        public void messageArrived(String topic,
                org.eclipse.paho.client.mqttv3.MqttMessage message) {
            final String commandTopic = topic;
            final String json = new String(
                message.getPayload(), java.nio.charset.StandardCharsets.UTF_8
            );
            if (topic.contains("/terminal/") && message.isRetained()) return;
			if (topic.contains("/command/auto-dispatch/")) {
				// 这里只写线程安全 Map，不访问 Truck 或其他仿真对象。
			    String requestId = manualJsonString(json, "requestId");
			    autoDispatchResponses.put(requestId, json);
			} else {
			    // 人工改派和速度控制都交给仿真线程事件处理。
			    manualDispatchQueue.offer(new String[] { commandTopic, json });
			}
        }

        public void deliveryComplete(
                org.eclipse.paho.client.mqttv3.IMqttDeliveryToken token) { }
    });

    fieldClient.connect(options).waitForCompletion(5000);
    traceln("[FieldMQTT] connected");
} catch (Exception e) {
    traceln("[FieldMQTT] connect failed: " + e.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790338720228</Id>
					<Name><![CDATA[publishFieldBytes]]></Name>
					<X>1025</X><Y>-1125</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[topic]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[payload]]></Name>
						<Type><![CDATA[byte[]]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[retained]]></Name>
						<Type><![CDATA[boolean]]></Type>
					</Parameter>
					<Body><![CDATA[if (fieldClient == null || !fieldClient.isConnected()) return;

try {
    int qos = retained ? 1 : 0;
    fieldClient.publish(topic, payload, qos, retained, null, null);
} catch (Exception e) {
    traceln(
        "[FieldMQTT] publish failed: "
        + topic
        + ": "
        + e.getMessage()
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790338792577</Id>
					<Name><![CDATA[publishMapState]]></Name>
					<X>1025</X><Y>-1095</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[mine.field.v1.MapState.Builder map = mine.field.v1.MapState.newBuilder()
    .setSimulationId(fieldSimId)
    .setSequence(++fieldSequence)
    .setSimTimeSeconds(time(SECOND))
    .setImageFile("image2.png")
    .setImageWidthPx(1920)
    .setImageHeightPx(957);

for (java.util.Map.Entry<String, PointNode> entry : roadPointNodeMap.entrySet()) {
    PointNode p = entry.getValue();
    map.addNodes(mine.field.v1.RoadNode.newBuilder()
        .setNodeId(entry.getKey()).setX(p.getX()).setY(p.getY()));
}
for (PathSegment s : segmentMap.values()) {
    map.addSegments(mine.field.v1.RoadSegment.newBuilder()
        .setSegmentId(s.key).setFromNodeId(s.from).setToNodeId(s.to)
        .setLengthModelUnits(s.length).setClosed(s.closed));
}
publishFieldBytes("mine/sim/" + fieldSimId + "/state/map",
    map.build().toByteArray(), true);
fieldMapPublished = true;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790338823539</Id>
					<Name><![CDATA[publishFieldStates]]></Name>
					<X>1025</X><Y>-1065</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double simSeconds = time(SECOND);
long wallMs = System.currentTimeMillis();
for (Truck t : trucks) {
    String phase = t.statechart.getState() == null
        ? "UNKNOWN" : t.statechart.getState().name();
    mine.field.v1.VehicleState msg = mine.field.v1.VehicleState.newBuilder()
        .setSimulationId(fieldSimId).setSequence(++fieldSequence)
        .setSimTimeSeconds(simSeconds).setSentWallTimeMs(wallMs)
        .setVehicleId(t.truckId).setX(t.getX()).setY(t.getY())
        .setSpeedMps(t.getSpeed(MPS))
        .setLoaded(t.isLoaded).setPayloadTons(t.payloadTons)
        .setCurrentNode(t.currentNode == null ? "" : t.currentNode)
        .setDestinationNode(t.destinationNode == null ? "" : t.destinationNode)
        .setCurrentSegmentId(t.currentSegment == null ? "" : t.currentSegment.key)
        .setTargetLoadSiteId(t.targetLoadSiteId)
        .setTargetDumpSiteId(t.targetDumpSiteId)
        .setStatechartState(phase).build();
    publishFieldBytes("mine/sim/" + fieldSimId + "/state/vehicle/" + t.truckId,
        msg.toByteArray(), false);
}
for (LoadSite s : loadSites) {
    mine.field.v1.ShovelState msg = mine.field.v1.ShovelState.newBuilder()
        .setSimulationId(fieldSimId).setSequence(++fieldSequence)
        .setSimTimeSeconds(simSeconds)
        .setShovelId(s.siteId)
        .setShovelName(s.siteName == null ? "" : s.siteName)
        .setX(s.getX()).setY(s.getY())
        .setAvailable(s.available).setBusy(s.busy)
        .setWaitingTrucks(s.getQueueSize())
        .setTrucksInService(s.numInService)
        .setOreGrade(s.grade).setRemainingTons(s.remainingTons)
        .setProducesOre(s.isOre).build();
    publishFieldBytes("mine/sim/" + fieldSimId + "/state/shovel/" + s.siteId,
        msg.toByteArray(), false);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1790391536817</Id>
					<Name><![CDATA[manualJsonString]]></Name>
					<X>1230</X><Y>-1165</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[key]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.regex.Matcher m = java.util.regex.Pattern.compile(
    "\\\"" + java.util.regex.Pattern.quote(key) +
    "\\\"\\s*:\\s*\\\"([^\\\"]*)\\\""
).matcher(json);
if (!m.find()) throw new IllegalArgumentException("missing " + key);
return m.group(1);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790392430933</Id>
					<Name><![CDATA[processManualDispatchQueue]]></Name>
					<X>1025</X><Y>-985</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[int handled = 0;
while (handled < 500) {
    String[] command = manualDispatchQueue.poll();
    if (command == null) break;
	
    try {
			if (command[0].contains("/command/speed/")) {
			    handleSpeedCommand(command[0], command[1]);
			} else if (command[0].contains("/terminal/")
			        && command[0].endsWith("/message")) {
			    handleTerminalMessage(command[0], command[1]);
			} else {
			    handleManualDispatchCommand(command[0], command[1]);
			}
    } catch (Exception e) {
        traceln("[ManualDispatch] command processing failed: " + e.getMessage());
    }
    handled++;
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1790392492325</Id>
					<Name><![CDATA[manualJsonInt]]></Name>
					<X>1230</X><Y>-1140</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[key]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.regex.Matcher m = java.util.regex.Pattern.compile(
    "\\\"" + java.util.regex.Pattern.quote(key) +
    "\\\"\\s*:\\s*(-?\\d+)"
).matcher(json);
if (!m.find()) throw new IllegalArgumentException("missing " + key);
return Integer.parseInt(m.group(1));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1790392546925</Id>
					<Name><![CDATA[manualJsonEscape]]></Name>
					<X>1230</X><Y>-1115</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[value]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (value == null) return "";
return value.replace("\\", "\\\\")
    .replace("\"", "\\\"")
    .replace("\r", "\\r")
    .replace("\n", "\\n");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790392586934</Id>
					<Name><![CDATA[publishManualDispatchResult]]></Name>
					<X>1225</X><Y>-1090</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[commandId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[truckId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[targetNode]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[status]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[message]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String json = "{"
    + "\"commandId\":\"" + manualJsonEscape(commandId) + "\","
    + "\"simulationId\":\"" + manualJsonEscape(fieldSimId) + "\","
    + "\"vehicleId\":" + truckId + ","
    + "\"targetNode\":\"" + manualJsonEscape(targetNode) + "\","
    + "\"status\":\"" + manualJsonEscape(status) + "\","
    + "\"message\":\"" + manualJsonEscape(message) + "\","
    + "\"executedAtMs\":" + System.currentTimeMillis()
    + "}";
try {
    if (fieldClient == null || !fieldClient.isConnected()) {
        throw new IllegalStateException("MQTT not connected");
    }
    fieldClient.publish(
        "mine/sim/" + fieldSimId + "/result/manual-dispatch/" + commandId,
        json.getBytes(java.nio.charset.StandardCharsets.UTF_8),
        1, false
    );
} catch (Exception e) {
    traceln("[ManualDispatch] result publish failed: " + e.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790392681542</Id>
					<Name><![CDATA[handleManualDispatchCommand]]></Name>
					<X>1225</X><Y>-1065</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[topic]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String commandId = topic.substring(topic.lastIndexOf('/') + 1);
String targetNode = "";
int truckId = -1;
try {
    String payloadCommandId = manualJsonString(json, "commandId");
    String simulationId = manualJsonString(json, "simulationId");
    targetNode = manualJsonString(json, "targetNode");
    truckId = manualJsonInt(json, "vehicleId");

    if (!commandId.equals(payloadCommandId) || !fieldSimId.equals(simulationId)) {
        throw new IllegalArgumentException("topic/payload identity mismatch");
    }

    Truck truck = null;
    for (Truck candidate : trucks) {
        if (candidate.truckId == truckId) { truck = candidate; break; }
    }
    if (truck == null) throw new IllegalArgumentException("vehicle not found");
    if (truck.pendingManualCommandId != null &&
            !truck.pendingManualCommandId.isEmpty()) {
        throw new IllegalStateException("vehicle already has a pending command");
    }
    String phase = truck.statechart.getState() == null
        ? "" : truck.statechart.getState().name();
    boolean travelling = phase.startsWith("PrepareRoute")
        || phase.startsWith("MoveSegment")
        || phase.startsWith("ArriveSegmentEnd")
        || phase.startsWith("CheckDestination");
    if (!travelling) {
        throw new IllegalStateException("vehicle is not travelling: " + phase);
    }

    boolean loadTarget = targetNode.equals("ShovelOreHigh1")
        || targetNode.equals("ShovelOreHigh2")
        || targetNode.equals("ShovelOreLow")
        || targetNode.equals("ShovelWaste");
    boolean dumpTarget = targetNode.equals("Crusher")
        || targetNode.equals("dumpNode");
    if ((!truck.isLoaded && !loadTarget) || (truck.isLoaded && !dumpTarget)) {
        throw new IllegalArgumentException("target incompatible with payload state");
    }
    if (getRoadPointNode(targetNode) == null) {
        throw new IllegalArgumentException("target node not found");
    }

    truck.pendingManualCommandId = commandId;
    truck.pendingManualTargetNode = targetNode;
    traceln("[ManualDispatch] queued command=" + commandId
        + " truck=" + truckId + " target=" + targetNode);
} catch (Exception e) {
    publishManualDispatchResult(commandId, truckId, targetNode,
        "REJECTED", e.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790492999521</Id>
					<Name><![CDATA[clip]]></Name>
					<X>340</X><Y>-1805</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[value]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[lower]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[upper]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return Math.max(lower, Math.min(upper, value));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790492999523</Id>
					<Name><![CDATA[gradeReward]]></Name>
					<X>340</X><Y>-1775</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[gap]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[double d;

if (gap < 0.0) {
    d = -gap / 0.02;
} else {
    d = gap / 0.01;
}

if (d <= 1.0) {
    // 合法区间内仅保留很小的中心偏好
    // 目标点0.60，合法边界0.50
    return 0.5 + 0.1 * (1.0 - d);
}

// 超出合法区间立即转为负值
return -clip(
    (d - 1.0) / 0.5,
    0.0,
    1.0
);
/*stage1
double d;

if (gap < 0.0) {
    d = -gap / 0.02;
} else {
    d = gap / 0.01;
}

// 安全区：目标点1.0，归一化偏差0.8处为0.5
if (d <= 0.8) {
    return 1.0 - 0.625 * d;
}

// 接近合法边界：奖励从0.5连续降低到0
if (d <= 1.0) {
    return 0.5 * (
        1.0 - (d - 0.8) / 0.2
    );
}

// 超出合法区间立即为负，d=1.5时达到-1
return -clip(
    (d - 1.0) / 0.5,
    0.0,
    1.0
);*/]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790492999525</Id>
					<Name><![CDATA[getCumulativeWaitVehicleSeconds]]></Name>
					<X>340</X><Y>-1745</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double waitMinutes =
    totalSystemLoadWaitTime + totalSystemDumpWaitTime;

// 尚未开始服务的车辆也必须持续贡献等待积分
for (Truck t : trucks) {
    if (t.isWaitingForLoadResource) {
        waitMinutes += Math.max(0.0, time(MINUTE) - t.queueEnterTime);
    }

    if (t.isWaitingForDumpResource) {
        waitMinutes += Math.max(
            0.0,
            time(MINUTE) - t.dumpQueueEnterTime
        );
    }
}

return waitMinutes * 60.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790492999527</Id>
					<Name><![CDATA[settleCurrent2hWindow]]></Name>
					<X>340</X><Y>-1715</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (currentWindowIndex < 0 || currentWindowIndex >= 4) {
    throw new IllegalStateException(
        "Invalid 2h window index: " + currentWindowIndex
    );
}

double grade =
    windowOreTons > 0
    ? windowMetalTons / windowOreTons
    : 0.0;

double gap =
    windowOreTons > 0
    ? targetGrade - grade
    : targetGrade; // 无矿不能按 gap=0 获得满分

closedWindowGrades[currentWindowIndex] = grade;
closedWindowGradeGaps[currentWindowIndex] = gap;

pendingGrade2hReward += wGrade2h * gradeReward(gap);

currentWindowIndex++;
windowOreTons = 0.0;
windowMetalTons = 0.0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790492999529</Id>
					<Name><![CDATA[advanceCompletedGradeWindows]]></Name>
					<X>340</X><Y>-1685</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nowSec]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[// 只关闭前三个边界；第 4 个窗口由 terminal 统一封账
while (
    currentWindowIndex < 3
    && nowSec >= (currentWindowIndex + 1) * rlWindowSeconds
) {
    settleCurrent2hWindow();
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790492999531</Id>
					<Name><![CDATA[finishEpisodeAndNotify]]></Name>
					<X>340</X><Y>-1635</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (episodeClosed) {
    return;
}

double nowSec = rlShiftSeconds;

// 先关闭尚未关闭的前三个窗口
advanceCompletedGradeWindows(nowSec);

// 再关闭第 4 个窗口
if (currentWindowIndex == 3) {
    settleCurrent2hWindow();
}

double shiftGrade =
    crusherOreTons > 0
    ? crusherMetalTons / crusherOreTons
    : 0.0;

double shiftGap =
    crusherOreTons > 0
    ? targetGrade - shiftGrade
    : targetGrade;

pendingGradeShiftReward =
    wGradeShift * gradeReward(shiftGap);

double productionFraction =
    crusherOreTons / targetOreTonsShift;

double productionShortfall =
    clip(1.0 - productionFraction, 0.0, 1.0);

pendingProductionReward =
    -wProduction * productionShortfall;

double cumulativeWait = getCumulativeWaitVehicleSeconds();
double deltaWaitVehicleSeconds = Math.max(
    0.0,
    cumulativeWait - lastWaitVehicleSeconds
);

double waitReward = -wWait * clip(
    (deltaWaitVehicleSeconds / Math.max(1, trucks.size()))
        / waitRefSeconds,
    0.0,
    1.0
);

double finalReward =
    waitReward
    + pendingGradeActionReward
    + pendingGrade2hReward
    + pendingGradeShiftReward
    + pendingProductionReward;
      
Observation terminalObs = lastDispatchObservation;

if (terminalObs == null) {
    if (trucks.isEmpty()) {
        throw new IllegalStateException(
            "No observation available for terminal request"
        );
    }
    terminalObs = buildObservation(trucks.get(0));
}

long seq = decisionSequence++;

DispatchRequest request = DispatchRequest.newBuilder()
    .setTruckId(-1)
    .setObs(terminalObs)
    .setEpisodeId(episodeId)
    .setDecisionSequence(seq)
    .setRequestId(episodeId + "-" + seq)
    .setKind(DispatchKind.EPISODE_END)
    .setActionRequired(false)
    .setPreviousAction(previousAction)
    .setTransitionReward(finalReward)
    .putRewardComponents("wait", waitReward)
    .putRewardComponents("grade_2h", pendingGrade2hReward)
    .putRewardComponents("grade_shift", pendingGradeShiftReward)
    .putRewardComponents("production", pendingProductionReward)
    .putRewardComponents(
        "delta_wait_vehicle_seconds",
        deltaWaitVehicleSeconds
    )
    .putRewardComponents("shift_grade", shiftGrade)
	.putRewardComponents("grade_gap_shift", shiftGap)
	.putRewardComponents(
	    "grade_shift_reward_raw",
	    gradeReward(shiftGap)
	)
	.putRewardComponents(
	    "production_fraction_raw",
	    productionFraction
	)
	.putRewardComponents("ore_tons_shift", crusherOreTons)
    .setSimTimeSeconds(nowSec)
    .setSimTimeDeltaSeconds(
        Math.max(0.0, nowSec - lastDecisionTimeSec)
    )
	.putRewardComponents(
	    "grade_action",
	    pendingGradeActionReward
	)
	.putRewardComponents(
	    "production_shortfall",
	    productionShortfall
	)
    .setTerminated(true)
    .setTruncated(false)
    .build();

rlClient.getDispatchResult(request);

episodeClosed = true;
getEngine().finish();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790492999533</Id>
					<Name><![CDATA[gradeDeviation]]></Name>
					<X>330</X><Y>-1605</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[gap]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!Double.isFinite(gap)) {
    return 3.0;
}

// gap < 0：实际品位高于0.25，允许到-0.02
// gap > 0：实际品位低于0.25，允许到+0.01
double deviation =
    gap < 0.0
    ? (-gap / 0.02)
    : (gap / 0.01);

// 防止异常品位产生过大的动作奖励
return clip(deviation, 0.0, 3.0);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790492999535</Id>
					<Name><![CDATA[calculateGradeActionReward]]></Name>
					<X>330</X><Y>-1575</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[action]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[LoadSite site = getLoadSiteById(action);

if (site == null) {
    return 0.0;
}

if (!site.isOre) {
    double shiftProgress =
        clip(time(SECOND) / rlShiftSeconds, 0.0, 1.0);

    double productionProgress =
        clip(
            crusherOreTons / targetOreTonsShift,
            0.0,
            1.0
        );

    double productionLag =
        shiftProgress - productionProgress;

    // 产量进度没有落后时允许选择WASTE；
    // 落后超过5%时，WASTE受到完整惩罚。
    double lagFactor = clip(
        productionLag / productionLagTolerance,
        0.0,
        1.0
    );

    return -wWasteLag * lagFactor;
}

double expectedTons = Math.max(1.0, t.capacity);
double priorTons = Math.max(gradePriorTons, expectedTons);

// --------------------------------------------------
// 1. 当前2小时窗口的反事实品位变化
// 使用目标品位的虚拟初始矿量，避免窗口初期一辆车
// 就把品位从0.25跳到0.38或0.15。
// --------------------------------------------------

double windowTonsBefore = windowOreTons + priorTons;
double windowMetalBefore =
    windowMetalTons + priorTons * targetGrade;

double windowGradeBefore =
    windowMetalBefore / windowTonsBefore;

double windowGapBefore =
    targetGrade - windowGradeBefore;

double windowTonsAfter =
    windowTonsBefore + expectedTons;

double windowMetalAfter =
    windowMetalBefore + expectedTons * site.grade;

double windowGradeAfter =
    windowMetalAfter / windowTonsAfter;

double windowGapAfter =
    targetGrade - windowGradeAfter;

double windowImprovement =
    gradeDeviation(windowGapBefore)
    - gradeDeviation(windowGapAfter);

windowImprovement = clip(
    windowImprovement,
    -gradeActionDeltaClip,
    gradeActionDeltaClip
);

// --------------------------------------------------
// 2. 班次累计品位的反事实变化
// --------------------------------------------------

double shiftTonsBefore =
    crusherOreTons + priorTons;

double shiftMetalBefore =
    crusherMetalTons + priorTons * targetGrade;

double shiftGradeBefore =
    shiftMetalBefore / shiftTonsBefore;

double shiftGapBefore =
    targetGrade - shiftGradeBefore;

double shiftTonsAfter =
    shiftTonsBefore + expectedTons;

double shiftMetalAfter =
    shiftMetalBefore + expectedTons * site.grade;

double shiftGradeAfter =
    shiftMetalAfter / shiftTonsAfter;

double shiftGapAfter =
    targetGrade - shiftGradeAfter;

double shiftImprovement =
    gradeDeviation(shiftGapBefore)
    - gradeDeviation(shiftGapAfter);

shiftImprovement = clip(
    shiftImprovement,
    -gradeActionDeltaClip,
    gradeActionDeltaClip
);

// 当前窗口更重要，班次累计用于防止窗口间抵消
double rawReward =
    0.70 * windowImprovement
    + 0.30 * shiftImprovement;

return wGradeAction * rawReward;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790505452959</Id>
					<Name><![CDATA[decisionJsonDouble]]></Name>
					<X>1580</X><Y>-1150</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[key]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.regex.Matcher m = java.util.regex.Pattern.compile(
    "\\\"" + java.util.regex.Pattern.quote(key)
    + "\\\"\\s*:\\s*(-?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?)"
).matcher(json);
if (!m.find()) throw new IllegalArgumentException("missing " + key);
double value = Double.parseDouble(m.group(1));
if (!Double.isFinite(value)) throw new IllegalArgumentException("non-finite " + key);
return value;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[long]]></ReturnType>
					<Id>1790505490349</Id>
					<Name><![CDATA[decisionJsonLong]]></Name>
					<X>1580</X><Y>-1130</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[key]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[java.util.regex.Matcher m = java.util.regex.Pattern.compile(
    "\\\"" + java.util.regex.Pattern.quote(key) + "\\\"\\s*:\\s*(-?\\d+)"
).matcher(json);
if (!m.find()) throw new IllegalArgumentException("missing " + key);
return Long.parseLong(m.group(1));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790505520960</Id>
					<Name><![CDATA[publishDecisionResult]]></Name>
					<X>1580</X><Y>-1110</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[commandId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[status]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[message]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String json = "{"
    + "\"commandId\":\"" + manualJsonEscape(commandId) + "\","
    + "\"simulationId\":\"" + manualJsonEscape(fieldSimId) + "\","
    + "\"status\":\"" + manualJsonEscape(status) + "\","
    + "\"message\":\"" + manualJsonEscape(message) + "\","
    + "\"executedAtMs\":" + System.currentTimeMillis()
    + "}";
try {
    fieldClient.publish(
        "mine/sim/" + fieldSimId + "/result/decision/" + commandId,
        json.getBytes(java.nio.charset.StandardCharsets.UTF_8),
        1, false
    ).waitForCompletion(3000);
} catch (Exception e) {
    traceln("[DecisionGateway] result publish failed: " + e.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1790505581423</Id>
					<Name><![CDATA[requestDispatchThroughBackend]]></Name>
					<X>1790</X><Y>-1180</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[request]]></Name>
						<Type><![CDATA[DispatchRequest]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[
if (fieldClient == null || !fieldClient.isConnected()) {
    throw new IllegalStateException("field MQTT is not connected");
}
// 每次派单前保证后台获得完整地图与车辆真实状态
publishMapState();
publishFieldStates();
String requestId = request.getRequestId();
try {
    fieldClient.publish(
        "mine/sim/" + fieldSimId + "/trigger/dispatch",
        request.toByteArray(), 1, false
    ).waitForCompletion(3000);
} catch (org.eclipse.paho.client.mqttv3.MqttException e) {
    // MqttPersistenceException 是 MqttException 的子类，也由这里覆盖。
    throw new IllegalStateException(
        "dispatch trigger publish failed: " + e.getMessage(), e
    );
}

long deadline = System.currentTimeMillis() + dispatchInferenceTimeoutMs;
String json = null;
while (System.currentTimeMillis() < deadline) {
    json = autoDispatchResponses.remove(requestId);
    if (json != null) break;
    try { Thread.sleep(5); }
    catch (InterruptedException e) {
        Thread.currentThread().interrupt();
        throw new IllegalStateException("dispatch wait interrupted");
    }
}
if (json == null) throw new IllegalStateException("dispatch backend timeout");

String commandId = manualJsonString(json, "commandId");
int responseTruckId = manualJsonInt(json, "vehicleId");
int action = manualJsonInt(json, "action");
String targetNode = manualJsonString(json, "targetNode");

String expectedTargetNode =
    action >= 0 && action < collectionLoadSites.size()
    ? collectionLoadSites.get(action).getName()
    : "";

if (responseTruckId != t.truckId
        || action < 0 || action > 3
        || getLoadSiteById(action) == null
        || !expectedTargetNode.equals(targetNode)) {
    publishDecisionResult(
        commandId,
        "REJECTED",
        "command mismatch: action=" + action
            + ", expected=" + expectedTargetNode
            + ", actual=" + targetNode
    );
    throw new IllegalStateException("invalid dispatch command");
}

t.pendingAutoCommandId = commandId;
return action;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790506108419</Id>
					<Name><![CDATA[handleSpeedCommand]]></Name>
					<X>1580</X><Y>-1080</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[topic]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String commandId = topic.substring(topic.lastIndexOf('/') + 1);
try {
    if (!commandId.equals(manualJsonString(json, "commandId"))
            || !fieldSimId.equals(manualJsonString(json, "simulationId"))) {
        throw new IllegalArgumentException("topic/payload identity mismatch");
    }
    int truckId = manualJsonInt(json, "vehicleId");
    String agentId = manualJsonString(json, "agentId");
    double acceleration = decisionJsonDouble(json, "accelerationMps2");
    long issuedAtMs = decisionJsonLong(json, "issuedAtMs");
    long validForMs = decisionJsonLong(json, "validForMs");
    if (!agentId.equals("agent_" + truckId)) {
        throw new IllegalArgumentException("agent/vehicle mismatch");
    }
    if (System.currentTimeMillis() - issuedAtMs > validForMs) {
        publishDecisionResult(commandId, "EXPIRED", "speed command expired");
        return;
    }
    Fusion.grpc.ActionDict actions = Fusion.grpc.ActionDict.newBuilder()
        .addActions(Fusion.grpc.Action.newBuilder()
            .setAgentId(agentId).addAction((float) acceleration))
        .build();
    applyInferenceAccelerations(actions, 0.5);
    publishDecisionResult(commandId, "EXECUTED",
        "acceleration applied: " + acceleration + " m/s2");
} catch (Exception e) {
    publishDecisionResult(commandId, "REJECTED", e.getMessage());
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790530637177</Id>
					<Name><![CDATA[emitProductionEvent]]></Name>
					<X>1460</X><Y>-1350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[type]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[siteId]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[if (productionRunId == null || !productionRunId.matches("[A-Za-z0-9_-]{1,80}")
        || fieldSimId == null || !fieldSimId.matches("[A-Za-z0-9_-]{1,64}")
        || t.productionCycleId == null) {
    traceln("[Production] missing real run/cycle identity");
    return;
}
String eventId = t.productionCycleId + "-" + type;
if (!productionEmitted.add(eventId)) return;
boolean finish = "DUMP_FINISH".equals(type);
String tons = "null", grade = "null", ore = "null", eligible = "null";
if (finish) {
    if (!Double.isFinite(t.payloadTons) || t.payloadTons < 0
            || !Double.isFinite(t.payloadGrade) || t.payloadGrade < 0 || t.payloadGrade > 1) {
        productionEmitted.remove(eventId);
        traceln("[Production] invalid original payload");
        return;
    }
    DumpSite ds = getDumpSiteById(siteId);
    boolean counted = ds != null && time(SECOND) < rlShiftSeconds
        && ((t.payloadIsOre && ds.acceptsOre && ds.siteId == 0)
            || (!t.payloadIsOre && ds.acceptsWaste));
    tons = Double.toString(t.payloadTons);
    grade = Double.toString(t.payloadGrade);
    ore = Boolean.toString(t.payloadIsOre);
    eligible = Boolean.toString(counted);
}
String commandJson = t.productionTaskCommandId == null ? "null"
    : "\"" + manualJsonEscape(t.productionTaskCommandId) + "\"";
String previousJson = t.productionPreviousCommandId == null ? "null"
    : "\"" + manualJsonEscape(t.productionPreviousCommandId) + "\"";
String payload = String.format(java.util.Locale.ROOT,
    "{\"schemaVersion\":1,\"eventId\":\"%s\",\"runId\":\"%s\","
    + "\"simulationId\":\"%s\",\"cycleId\":\"%s\",\"vehicleId\":%d,"
    + "\"eventType\":\"%s\",\"siteId\":%d,\"simTimeSeconds\":%.9f,"
    + "\"sentWallTimeMs\":%d,\"commandId\":%s,\"previousCommandId\":%s,\"payloadTons\":%s,"
    + "\"payloadGrade\":%s,\"producesOre\":%s,\"productionEligible\":%s}",
    eventId, productionRunId, fieldSimId, t.productionCycleId, t.truckId,
    type, siteId, time(SECOND), System.currentTimeMillis(), commandJson, previousJson,
	tons, grade, ore, eligible);
String topic = "mine/sim/" + fieldSimId + "/event/production/" + t.truckId;
productionOutbox.putIfAbsent(eventId, new String[]{topic, payload});
// 由独立 cyclic event 发送，不在控制/装卸回调中等待 MQTT。]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790530736818</Id>
					<Name><![CDATA[flushProductionEvents]]></Name>
					<X>1460</X><Y>-1320</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (fieldClient == null || !fieldClient.isConnected()) return;
for (java.util.Map.Entry<String,String[]> entry : productionOutbox.entrySet()) {
    final String id = entry.getKey();
    final String[] data = entry.getValue();
    if (!productionInFlight.add(id)) continue;
    try {
        fieldClient.publish(data[0], data[1].getBytes(java.nio.charset.StandardCharsets.UTF_8),
            1, false, null, new org.eclipse.paho.client.mqttv3.IMqttActionListener() {
                public void onSuccess(org.eclipse.paho.client.mqttv3.IMqttToken token) {
                    productionOutbox.remove(id, data);
                    productionInFlight.remove(id);
                }
                public void onFailure(org.eclipse.paho.client.mqttv3.IMqttToken token, Throwable error) {
                    productionInFlight.remove(id);
                }
            });
    } catch (Exception e) {
        productionInFlight.remove(id);
        traceln("[Production] publish pending: " + e.getMessage());
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1790585173140</Id>
					<Name><![CDATA[handleTerminalMessage]]></Name>
					<X>1300</X><Y>-1030</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[topic]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String[] parts = topic.split("/");
if (parts.length != 7 || !"mine".equals(parts[0])
        || !"sim".equals(parts[1]) || !fieldSimId.equals(parts[2])
        || !"terminal".equals(parts[3]) || !"message".equals(parts[6])) {
    throw new IllegalArgumentException("invalid terminal message topic");
}

String terminalType = parts[4];
int terminalId = Integer.parseInt(parts[5]);
String sourceId = manualJsonString(json, "messageId");
if (!("VEHICLE".equals(terminalType) || "SHOVEL".equals(terminalType))
        || !sourceId.matches("[A-Za-z0-9_-]{1,60}")
        || manualJsonInt(json, "schemaVersion") != 1
        || !fieldSimId.equals(manualJsonString(json, "simulationId"))
        || !terminalType.equals(manualJsonString(json, "targetType"))
        || terminalId != manualJsonInt(json, "targetId")) {
    throw new IllegalArgumentException("terminal topic/payload mismatch");
}

boolean targetExists = false;
if ("VEHICLE".equals(terminalType)) {
    for (Truck t : trucks) {
        if (t != null && t.truckId == terminalId) targetExists = true;
    }
} else {
    for (LoadSite s : loadSites) {
        if (s != null && s.siteId == terminalId) targetExists = true;
    }
}
if (!targetExists) throw new IllegalArgumentException("terminal target does not exist");
if (fieldClient == null || !fieldClient.isConnected()) {
    throw new IllegalStateException("field MQTT is not connected");
}

String responseTopic = "mine/sim/" + fieldSimId + "/terminal/"
        + terminalType + "/" + terminalId + "/response";
String response = String.format(java.util.Locale.ROOT,
        "{\"schemaVersion\":1,\"messageId\":\"ack-%s\","
        + "\"simulationId\":\"%s\",\"terminalType\":\"%s\","
        + "\"terminalId\":%d,\"senderName\":\"AnyLogic AUTO_ACK\","
        + "\"text\":\"AnyLogic 已接收调度消息\",\"sentAtMs\":%d,"
        + "\"replyToMessageId\":\"%s\"}",
        sourceId, fieldSimId, terminalType, terminalId,
        System.currentTimeMillis(), sourceId);
try {
    fieldClient.publish(responseTopic,
            response.getBytes(java.nio.charset.StandardCharsets.UTF_8),
            1, false, null, null);
} catch (org.eclipse.paho.client.mqttv3.MqttException e) {
    throw new IllegalStateException(
            "terminal response publish failed: " + e.getMessage(), e);
}
traceln("[TerminalMessage] received " + sourceId
        + " for " + terminalType + terminalId);]]></Body>
				</Function>
			</Functions>
			<AgentLinks>
				<AgentLink>
