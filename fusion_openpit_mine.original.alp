				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1776934595976</Id>
					<Name><![CDATA[selectNextLoadSiteAI]]></Name>
					<X>660</X><Y>-680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[if (!enableOnnxDispatch
        || fieldClient == null
        || !fieldClient.isConnected()) {
    throw new IllegalStateException(
        "Dispatch backend MQTT is unavailable"
    );
}

Observation obs = buildObservation(t);
double nowSec = time(SECOND);

boolean isStart = !episodeStarted;

double deltaWaitVehicleSeconds = 0.0;
double waitReward = 0.0;
double simDeltaSeconds = 0.0;

if (!isStart) {
    double cumulativeWait = getCumulativeWaitVehicleSeconds();

    deltaWaitVehicleSeconds = Math.max(
        0.0,
        cumulativeWait - lastWaitVehicleSeconds
    );

    double meanWaitPerTruck =
        deltaWaitVehicleSeconds / Math.max(1, trucks.size());

	waitReward = -wWait * clip(
	    meanWaitPerTruck / waitRefSeconds,
	    0.0,
	    1.0
	);

    simDeltaSeconds = Math.max(0.0, nowSec - lastDecisionTimeSec);
}

double transitionReward =
    isStart
    ? 0.0
    : waitReward
        + pendingGradeActionReward
        + pendingGrade2hReward
        + pendingGradeShiftReward
        + pendingProductionReward;

long seq = decisionSequence++;
String requestId = episodeId + "-" + seq;

DispatchRequest request = DispatchRequest.newBuilder()
    .setTruckId(t.truckId)
    .setObs(obs)
    .setEpisodeId(episodeId)
    .setDecisionSequence(seq)
    .setRequestId(requestId)
    .setKind(
        isStart
        ? DispatchKind.EPISODE_START
        : DispatchKind.DECISION
    )
    .setActionRequired(true)
    .setPreviousAction(isStart ? -1 : previousAction)
    .setTransitionReward(transitionReward)
    .putRewardComponents("wait", isStart ? 0.0 : waitReward)
    .putRewardComponents("grade_2h", pendingGrade2hReward)
    .putRewardComponents("grade_shift", pendingGradeShiftReward)
    .putRewardComponents("production", pendingProductionReward)
    .putRewardComponents(
        "delta_wait_vehicle_seconds",
        deltaWaitVehicleSeconds
    )
    .putRewardComponents(
	    "grade_action",
	    isStart ? 0.0 : pendingGradeActionReward
	)
    .setSimTimeSeconds(nowSec)
    .setSimTimeDeltaSeconds(simDeltaSeconds)
    .setTerminated(false)
    .setTruncated(false)
    .build();

int action = requestDispatchThroughBackend(request, t);

if (action < 0 || action > 3 || getLoadSiteById(action) == null) {
    throw new IllegalStateException("Invalid dispatch action: " + action);
}
double nextGradeActionReward =
    calculateGradeActionReward(t, action);

// 只有 RPC 成功后才消费 reward，避免异常时丢失
episodeStarted = true;
previousAction = action;
lastDispatchObservation = obs;
lastWaitVehicleSeconds = getCumulativeWaitVehicleSeconds();
lastDecisionTimeSec = nowSec;

// 当前request已经成功发送，消费上一transition的奖励
pendingGradeActionReward = 0.0;
pendingGrade2hReward = 0.0;
pendingGradeShiftReward = 0.0;
pendingProductionReward = 0.0;

// 当前action的品位奖励属于 action -> next state，
// 留到下一次DECISION或EPISODE_END返回
pendingGradeActionReward = nextGradeActionReward;

return action;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1781763277868</Id>
					<Name><![CDATA[init2]]></Name>
					<X>280</X><Y>-590</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[// ---------- 初始化 LoadSite population ----------

dynamic = true;

LoadSite s0 = add_loadSites();
s0.setLocation(ShovelOreHigh1);
s0.initLoadSite(0, "High1", true,0.38, 100000, 0.483,ShovelOreHigh1.getX(),ShovelOreHigh1.getY(),12, 1.6);

LoadSite s1 = add_loadSites();
s1.setLocation(ShovelOreHigh2);
s1.initLoadSite(1, "High2", true, 0.3, 100000, 0.483,ShovelOreHigh2.getX(),ShovelOreHigh2.getY(), 12, 1.6);

LoadSite s2 = add_loadSites();
s2.setLocation(ShovelOreLow);
s2.initLoadSite(2, "Low", true, 0.15, 100000, 0.483,ShovelOreLow.getX(),ShovelOreLow.getY(),12, 1.6);

LoadSite s3 = add_loadSites();
s3.setLocation(ShovelWaste);
s3.initLoadSite(3, "Waste", false, 0.00, 100000, 0.483 ,ShovelWaste.getX(),ShovelWaste.getY(),12, 1.6);

// ---------- 初始化 DumpSite population ----------

DumpSite d0 = add_dumpSites();
d0.setLocation(Crusher);
d0.initDumpSite(0, "Crusher", true, false, 2.5);

DumpSite d1 = add_dumpSites();
d1.setLocation(dumpNode);
d1.initDumpSite(1, "Dump", false, true, 2.0);

// ---------- 初始化 Truck population ----------


for(int i = 0; i < numTrucks; i++){

    Truck t = add_trucks();
    t.delay = i * 10;
    if(i % 4 == 3){
    	t.setLocation(dumpNode);
    }else{
        t.setLocation(collectionTrucks.get(i+15));
    }

    if (dynamic == false){
    	t.targetShovel = getLoadSiteById(i%4);
    }
    t.setSpeed(25,KPH);
    t.initTruck(i, truckCapacity);
    t.deliver("ACTIVATE", t);

}
// ---------- 初始化 Stats population ----------

for(int i = 0; i < 4 ; i++ ){
	loadingPointStatsList.get(i).loadingPointName = collectionLoadSites.get(i).getName();
}





// ---------- 初始化全局统计 ----------
crusherOreTons = 0;
crusherMetalTons = 0;
currentFeedGrade = 0;
gradeGap = targetGrade - currentFeedGrade;

totalProduction = 0;
totalWasteMoved = 0;
totalWaitTime = 0;
totalTravelTime = 0;
totalCycleTime = 0;
completedTrips = 0;

P2LList = P2L();
P2DList = P2D();
L2DList = L2D();



]]></Body>
				</Function>
