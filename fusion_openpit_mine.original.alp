				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1782716629203</Id>
					<Name><![CDATA[init_network]]></Name>
					<X>140</X><Y>-420</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[segmentMap.clear();

double defaultSpeed = 10; // m/s，后面可改成每段不同限速

// crusher → ShovelOreHigh2 的正向物理路段
addBidirectionalPath("Crusher", "intersection1",  defaultSpeed);
addBidirectionalPath("intersection1", "intersection2",  defaultSpeed);
addBidirectionalPath("intersection2", "intersection3", defaultSpeed);
addBidirectionalPath("intersection3", "ShovelOreHigh2",  defaultSpeed);

// crusher → ShovelOreHigh1
addBidirectionalPath("intersection2", "ShovelOreHigh1",  defaultSpeed);;

//crusher -> ShovelOreLow
addBidirectionalPath("intersection3", "ShovelOreLow",  defaultSpeed);

//crusher -> ShovelWaste
addBidirectionalPath("intersection2", "ShovelWaste",  defaultSpeed);
// 如果有 wasteDump → loadSite，也同样按卸载点到装载点方向写
addBidirectionalPath("dumpNode", "intersection2", defaultSpeed);

traceln("segmentMap keys = " + segmentMap.keySet());]]></Body>
				</Function>
