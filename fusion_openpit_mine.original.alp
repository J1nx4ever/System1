					<Id>1776855571076</Id>
					<Name><![CDATA[P2D]]></Name>
					<X>660</X><Y>-490</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[double[] P2DList = new double[2];
double sum = 0;
double ave = 0;
for (int i = 0 ; i < collectionDumpSites.size(); i++){
	P2DList[i] = DistanceRecorder(parking.getX(), parking.getY(),
	collectionDumpSites.get(i).getX(),collectionDumpSites.get(i).getY());
	sum += P2DList[i];
}
traceln("P2D" + ave);
return P2DList;]]></Body>
