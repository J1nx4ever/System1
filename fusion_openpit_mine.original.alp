				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783067303037</Id>
					<Name><![CDATA[destinationToInt]]></Name>
					<X>-250</X><Y>-370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[destination]]></Name>
						<Type><![CDATA[PointNode]]></Type>
					</Parameter>
					<Body><![CDATA[int  intDestination = 0;

if(destination == intersection1) intDestination = 1;
if(destination == intersection2) intDestination = 2;
if(destination == intersection3) intDestination = 3;
if(destination == ShovelOreLow) intDestination = 4;
if(destination == ShovelOreHigh2) intDestination = 5;
if(destination == ShovelOreHigh1) intDestination = 6;
if(destination == ShovelWaste) intDestination = 7;
if(destination == Crusher) intDestination = 8;
if(destination == dumpNode) intDestination = 9;

return intDestination;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1783159110256</Id>
					<Name><![CDATA[roadNodeNameToInt]]></Name>
					<X>-250</X><Y>-330</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[nodeName]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[
if (nodeName == null) return 0;

if (nodeName.equals("intersection1")) return 1;
if (nodeName.equals("intersection2")) return 2;
if (nodeName.equals("intersection3")) return 3;

if (nodeName.equals("ShovelOreLow")) return 4;
if (nodeName.equals("ShovelOreHigh2")) return 5;
if (nodeName.equals("ShovelOreHigh1")) return 6;
if (nodeName.equals("ShovelWaste")) return 7;

if (nodeName.equals("Crusher")) return 8;
if (nodeName.equals("dumpNode")) return 9;

return 0;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Fusion.grpc.EnvInfoDict]]></ReturnType>
					<Id>1783323717940</Id>
					<Name><![CDATA[get_info]]></Name>
					<X>1280</X><Y>-880</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Fusion.grpc.EnvInfoDict.Builder infoBuilder =
    Fusion.grpc.EnvInfoDict.newBuilder();

for (Truck t : trucks) {
    Fusion.grpc.TruckInfo info =
        Fusion.grpc.TruckInfo.newBuilder()
            .setAgentId("agent_" + t.truckId)
            .setFuelConsumption(0)
            .setDistanceTraveled(0)
            .setTriggerType("speed_control")
            .setEventName("speed_step")
            .build();

    infoBuilder.addInfos(info);
}

return infoBuilder.build();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783323736821</Id>
					<Name><![CDATA[applySpeedActions]]></Name>
					<X>1280</X><Y>-840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[request]]></Name>
						<Type><![CDATA[Fusion.grpc.ActionDict ]]></Type>
					</Parameter>
					<Body><![CDATA[
if (request == null) {
    return;
}

for (Fusion.grpc.Action action : request.getActionsList()) {

    String agentId = action.getAgentId();

    if (agentId == null || agentId.length() == 0) {
        continue;
    }

    String idText = agentId.replace("agent_", "");

    int truckId;
    try {
        truckId = Integer.parseInt(idText);
    } catch (Exception e) {
        traceln("[SpeedControl] Invalid agent id: " + agentId);
        continue;
    }

    if (action.getActionCount() == 0) {
        continue;
    }

    double accel = action.getAction(0);

    for (Truck t : trucks) {
        if (t.truckId == truckId) {

            t.prevCmdAccel = t.cmdAccel;
            t.cmdAccel = accel;

            double currentSpeed = 0;

            try {
                currentSpeed = t.getSpeed();
            } catch (Exception e) {
                currentSpeed = t.egoSpeed;
            }

            double dt = 0.1;
            double newSpeed = currentSpeed + accel * dt;

            if (newSpeed < 0) {
                newSpeed = 0;
            }

            if (newSpeed > 15) {
                newSpeed = 15;
            }

            try {
                t.setSpeed(newSpeed, MPS);
            } catch (Exception e) {
                try {
                    t.setSpeed(newSpeed);
                } catch (Exception ex) {
                    traceln("[SpeedControl] setSpeed failed for truck " + truckId);
                }
            }

            break;
        }
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
