				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1782802968408</Id>
					<Name><![CDATA[prepareRoute]]></Name>
					<X>1560</X><Y>610</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[start]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[destination]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (start == null || destination == null
        || start.isEmpty() || destination.isEmpty()) {
    traceln("[Route] invalid route endpoints");
    return;
}

PointNode startPoint = main.getRoadPointNode(start);
PointNode destinationPoint = main.getRoadPointNode(destination);

if (startPoint == null || destinationPoint == null) {
    traceln("[Route] endpoint node not found: "
        + start + " -> " + destination);
    return;
}

ArrayList<PathSegment> routeSegments =
    main.getRouteSegments(start, destination);
ArrayList<String> routeNodes = new ArrayList<String>();
routeNodes.add(start);

String expectedFrom = start;

for (PathSegment segment : routeSegments) {
    if (segment == null || segment.closed
            || !expectedFrom.equals(segment.from)) {
        traceln("[Route] discontinuous route at "
            + expectedFrom + " -> " + destination);
        return;
    }

    routeNodes.add(segment.to);
    expectedFrom = segment.to;
}

if (!start.equals(destination)
        && (routeSegments.isEmpty()
            || !destination.equals(expectedFrom))) {
    traceln("[Route] incomplete route: "
        + start + " -> " + destination);
    return;
}

currentNode = start;
destinationNode = destination;
intDestination = main.roadNodeNameToInt(destination);
currentRouteNodes = routeNodes;
currentRouteSegments = routeSegments;
currentRouteKey = start + "_" + destination;

currentNodeId = main.destinationToInt(startPoint);

if (routeSegments.isEmpty()) {
    currentSegmentIndex = -1;
    currentSegment = null;
    targetNodeName = null;
    targetNodeId = main.destinationToInt(destinationPoint);
    direction = 0.0;
    remainingDistanceOnSegment = 0.0;
    remainingDistanceToDestination = 0.0;
    return;
}

currentSegmentIndex = 0;
currentSegment = currentRouteSegments.get(0);
direction = currentSegment.direction;

targetNodeName = currentSegment.to;
PointNode targetPoint = main.getRoadPointNode(targetNodeName);

if (targetPoint == null) {
    traceln("[Route] segment target node not found: " + targetNodeName);
    currentSegment = null;
    targetNodeName = null;
    currentRouteNodes = new ArrayList<String>();
    currentRouteSegments = new ArrayList<PathSegment>();
    currentSegmentIndex = -1;
    return;
}

targetNodeId = main.destinationToInt(targetPoint);
remainingDistanceOnSegment = currentSegment.length;
remainingDistanceToDestination = calculateDisToDes();

traceln("[Route] bound " + start + " -> " + destination
    + " with " + currentRouteSegments.size() + " segments");]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783068232576</Id>
					<Name><![CDATA[calculateDisOnSeg]]></Name>
					<X>1680</X><Y>900</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (targetNodeName == null || targetNodeName.equals("")) {
    return 0;
}

PointNode targetNode = main.getRoadPointNode(targetNodeName);

if (targetNode == null) {
    traceln("Truck " + truckId + " targetNode not found: " + targetNodeName);
    return 0;
}

Point currentPos = new Point(this.getX(), this.getY());
Point targetPos  = new Point(targetNode.getX(), targetNode.getY());

ContinuousShortestPathData out = new ContinuousShortestPathData();
main.network.getPathData(currentPos, targetPos, out);

return out.distance;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783069578929</Id>
					<Name><![CDATA[calculateDisToDes]]></Name>
					<X>1690</X><Y>930</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[/*
if (currentSegment == null || currentRouteSegments == null || currentRouteSegments.size() == 0) {
    return 0;
}
*/
double total = remainingDistanceOnSegment;

for (int i = currentSegmentIndex + 1; i < currentRouteSegments.size(); i++) {
    total += currentRouteSegments.get(i).length;
}

return total;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783308773366</Id>
					<Name><![CDATA[calcTTA]]></Name>
					<X>1180</X><Y>820</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[dist]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[speed]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (dist <= 0) {
    return 0;
}

if (speed <= minSpeedForTTA) {
    return maxTTA;
}

return dist / speed;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783321689250</Id>
					<Name><![CDATA[updateBasicSpeedState]]></Name>
					<X>1100</X><Y>1020</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[try {
    egoSpeed = getSpeed();
} catch (Exception e) {
    egoSpeed = 0.0;
}

if (Double.isNaN(egoSpeed)
    || Double.isInfinite(egoSpeed)
    || egoSpeed < 0.0) {
    egoSpeed = 0.0;
}

try {
    // 与训练 ALP 中 truck.get_distance() 的语义对齐：
    // 当前车辆到当前有向路段下游目标节点的剩余距离。
    remainingDistanceOnSegment = calculateDisOnSeg();

    if (Double.isNaN(remainingDistanceOnSegment)
        || Double.isInfinite(remainingDistanceOnSegment)
        || remainingDistanceOnSegment < 0.0) {
        remainingDistanceOnSegment = 0.0;
    }

    disToInt = remainingDistanceOnSegment;
} catch (Exception e) {
    remainingDistanceOnSegment = 0.0;
    disToInt = 0.0;
}

// 这里只保存原始秒数。发送 proto 时再按训练公式归一化。
tta = calcTTA(disToInt, egoSpeed);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783906367599</Id>
					<Name><![CDATA[onLoadingFinished]]></Name>
					<X>130</X><Y>800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ls]]></Name>
						<Type><![CDATA[LoadSite]]></Type>
					</Parameter>
					<Body><![CDATA[isLoaded = true;
loadFinishedFlag = true;
hasEnteredCurrentProcess = false;
payloadTons = capacity;
if( targetShovel != null){
    payloadIsOre = targetShovel.isOre;
    payloadGrade = targetShovel.grade;
    targetShovel.remainingTons -= payloadTons;
    targetShovel.producedTons += payloadTons;
    targetShovel.busy = false;
    main.emitProductionEvent(this, "LOADING_FINISH", ls.siteId);
}
currentNode = destinationNode;
traceln("Truck " + truckId
    + " loading finished at " + ls.siteName);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783927117311</Id>
					<Name><![CDATA[onDumpingFinished]]></Name>
					<X>-20</X><Y>1280</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[ds]]></Name>
						<Type><![CDATA[DumpSite]]></Type>
					</Parameter>
					<Body><![CDATA[targetDump = ds;

dumpFinishedFlag = true;
hasEnteredCurrentProcess = false;

DumpSite d =
    main.getDumpSiteById(currentDumpSiteId);

double nowSec = time(SECOND);

if (d == null) {
    throw new IllegalStateException(
        "Unknown dump site: "
        + currentDumpSiteId
    );
}

// 28800 秒时完成的卸载不计入本班
if (nowSec < main.rlShiftSeconds) {

    if (
        payloadIsOre
        && d.acceptsOre
        && d.siteId == 0
    ) {
        main.totalProduction += payloadTons;

        main.updateCrusherGrade(
            payloadTons,
            payloadGrade
        );

        d.receivedTons += payloadTons;

    } else if (
        !payloadIsOre
        && d.acceptsWaste
    ) {
        main.totalWasteMoved += payloadTons;
        d.receivedTons += payloadTons;
    }
}

d.busy = false;

isLoaded = false;

if (productionCycleId != null) {
    main.emitProductionEvent(this, "DUMP_FINISH", ds.siteId);
    productionCycleId = null;
}

productionTaskCommandId = null;
productionPreviousCommandId = null;

payloadIsOre = false;
payloadGrade = 0.0;
payloadTons = 0.0;

isWaitingForDumpResource = false;
executionPhase = "COMPLETED";

productionTaskCommandId = null;
productionPreviousCommandId = null;
debugLastAction = "FinishDump";
currentNode = destinationNode;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1790392810142</Id>
					<Name><![CDATA[applyPendingManualDispatchAtNode]]></Name>
					<X>1720</X><Y>370</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (pendingManualCommandId == null
        || pendingManualCommandId.isEmpty()) {
    return false;
}

String commandId = pendingManualCommandId;
String target = pendingManualTargetNode;
String routeStart = currentNode;

try {
    if (routeStart == null || routeStart.isEmpty()) {
        throw new IllegalStateException("current node is empty");
    }

    PointNode targetPoint = main.getRoadPointNode(target);
    if (targetPoint == null) {
        throw new IllegalArgumentException("target node not found: " + target);
    }

    boolean loadTarget =
        target.equals("ShovelOreHigh1")
        || target.equals("ShovelOreHigh2")
        || target.equals("ShovelOreLow")
        || target.equals("ShovelWaste");

    boolean dumpTarget =
        target.equals("Crusher")
        || target.equals("dumpNode");

    if ((!isLoaded && !loadTarget)
            || (isLoaded && !dumpTarget)) {
        throw new IllegalArgumentException(
            "target incompatible with payload state"
        );
    }

    ArrayList<PathSegment> replacement =
        main.getRouteSegments(routeStart, target);

    if (!routeStart.equals(target)) {
        if (replacement == null || replacement.isEmpty()) {
            throw new IllegalStateException(
                "route not found from " + routeStart + " to " + target
            );
        }

        PathSegment lastSegment = replacement.get(replacement.size() - 1);
        if (!target.equals(lastSegment.to)) {
            throw new IllegalStateException(
                "route does not end at target " + target
            );
        }
    }

    int newLoadSiteId = -1;
    LoadSite newShovel = null;
    int newDumpSiteId = -1;
    DumpSite newDump = null;

    if (!isLoaded) {
        for (int i = 0; i < main.collectionLoadSites.size(); i++) {
            if (target.equals(main.collectionLoadSites.get(i).getName())) {
                newLoadSiteId = i;
                break;
            }
        }

        if (newLoadSiteId < 0) {
            throw new IllegalArgumentException("load target not found: " + target);
        }

        newShovel = main.getLoadSiteById(newLoadSiteId);
        if (newShovel == null) {
            throw new IllegalStateException(
                "load site object not found: " + target
            );
        }
    } else {
        newDumpSiteId = target.equals("Crusher") ? 0
            : target.equals("dumpNode") ? 1 : -1;

        if (newDumpSiteId < 0) {
            throw new IllegalArgumentException("dump target not found: " + target);
        }

        newDump = main.getDumpSiteById(newDumpSiteId);
        if (newDump == null) {
            throw new IllegalStateException(
                "dump site object not found: " + target
            );
        }
    }

    prepareRoute(routeStart, target);

    if (!routeStart.equals(target)
            && (currentRouteSegments == null
                || currentRouteSegments.isEmpty()
                || currentSegment == null
                || !target.equals(
                    currentRouteSegments.get(
                        currentRouteSegments.size() - 1
                    ).to
                ))) {
        throw new IllegalStateException(
            "route binding failed: " + routeStart + " -> " + target
        );
    }

    if (!isLoaded) {
        if (targetShovel != null && targetShovel.incomingTrucks > 0) {
            targetShovel.incomingTrucks--;
        }

        targetLoadSiteId = newLoadSiteId;
        targetShovel = newShovel;
        targetShovel.incomingTrucks++;
    } else {
        targetDumpSiteId = newDumpSiteId;
        targetDump = newDump;
    }

    // CheckDestination 随后会发送 NEXTSEGMENT，转移动作会先 ++。
    if (!routeStart.equals(target)) {
        currentSegmentIndex = -1;
    }
	productionPreviousCommandId = productionTaskCommandId;
	productionTaskCommandId = commandId;
    debugLastAction = "ManualDispatch_" + target;
    pendingManualCommandId = "";
    pendingManualTargetNode = "";

    traceln("[ManualDispatch] route bound command=" + commandId
        + " truck=" + truckId
        + " from=" + routeStart
        + " to=" + target
        + " segments=" + currentRouteSegments.size());

    main.publishManualDispatchResult(
        commandId,
        truckId,
        target,
        "EXECUTED",
        "route bound at " + routeStart
    );
    return true;

} catch (Exception e) {
    pendingManualCommandId = "";
    pendingManualTargetNode = "";

    traceln("[ManualDispatch] route binding failed command="
        + commandId + " truck=" + truckId
        + " reason=" + e.getMessage());

    main.publishManualDispatchResult(
        commandId,
        truckId,
        target,
        "REJECTED",
        e.getMessage()
    );
    return false;
}]]></Body>
				</Function>
