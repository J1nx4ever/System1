				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Fusion.grpc.ObservationDict]]></ReturnType>
					<Id>1783323980904</Id>
					<Name><![CDATA[buildSpeedObservations]]></Name>
					<X>1280</X><Y>-760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[stage]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[Fusion.grpc.ObservationDict.Builder dictBuilder =
    Fusion.grpc.ObservationDict.newBuilder();

for (Truck t : trucks) {
    Fusion.grpc.Observation obs =
        Fusion.grpc.Observation.newBuilder()
            .setAgentId("agent_" + t.truckId)
            .setState(buildSpeedState(t, stage))
            .build();

    dictBuilder.addObservations(obs);
}

return dictBuilder.build();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Fusion.grpc.StateData]]></ReturnType>
					<Id>1783324059850</Id>
					<Name><![CDATA[buildSpeedState]]></Name>
					<X>1280</X><Y>-720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[stage]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[Fusion.grpc.StateData.Builder sb =
    Fusion.grpc.StateData.newBuilder();

// ============================================================
// 1. 自车物理量
// ============================================================
double egoSpeedMps;
try {
    egoSpeedMps = t.getSpeed();
} catch (Exception e) {
    egoSpeedMps = t.egoSpeed;
}

if (!Double.isFinite(egoSpeedMps) || egoSpeedMps < 0.0) {
    egoSpeedMps = 0.0;
}

double distanceToNextNodeM = t.disToInt;
if (!Double.isFinite(distanceToNextNodeM) || distanceToNextNodeM < 0.0) {
    distanceToNextNodeM = 0.0;
}

// ============================================================
// 2. 严格复现训练 ALP 的基础特征
// ============================================================
double egoSpeedFeature = egoSpeedMps / 15.0;

// 训练 get_lane_progress():
// (currentSegmentLength - remainingDistance) / currentSegmentLength
double laneProgressFeature = 0.0;
if (t.currentSegment != null && t.currentSegment.length > 1e-9) {
    double progressM =
        t.currentSegment.calcProgressFromRemainingDistance(
            distanceToNextNodeM
        );
    laneProgressFeature = progressM / t.currentSegment.length;
}
laneProgressFeature =
    Math.max(0.0, Math.min(1.0, laneProgressFeature));

// 训练 ALP 中 distanceToDestination 由 truck.get_distance() 写入，
// 即当前路段/目标节点剩余距离，不是整个运输路径距离。
double ttaFeature;
if (egoSpeedMps > 0.1) {
    double physicalTtaS = distanceToNextNodeM / egoSpeedMps;
    ttaFeature = 1.0 - Math.exp(-physicalTtaS / 65.0);
} else {
    ttaFeature = distanceToNextNodeM > 0.0 ? 1.0 : 0.0;
}
ttaFeature = Math.max(0.0, Math.min(1.0, ttaFeature));

sb.setEgoAgentId(t.truckId);
sb.setTargetRoadNode(t.targetNodeId);
sb.setEgoSpeed(egoSpeedFeature);
sb.setDistToInt(laneProgressFeature);
sb.setTtaEgo(ttaFeature);
sb.setPrevCmdAccel(t.prevCmdAccel);

// ============================================================
// 3. 前后车特征
// ============================================================
if (stage >= 2) {
    if (t.hasFront) {
        double frontSpeedMps = Math.max(0.0, t.frontSpeed);
        double frontDistanceM = Math.max(0.0, t.frontDis);
        double closingSpeedMps = egoSpeedMps - frontSpeedMps;

        double frontDistanceFeature =
            1.0 / (
                1.0 + Math.exp((frontDistanceM - 20.0) / 3.0)
            );

        double frontTtcFeature = 0.0;
        if (closingSpeedMps > 0.1) {
            double physicalTtcS = frontDistanceM / closingSpeedMps;
            frontTtcFeature = Math.exp(-physicalTtcS / 3.0);
        }

        sb.setHasFront(true);
        sb.setFrontAgentId(t.front_id);
        sb.setFrontSpeed(frontSpeedMps / 15.0);
        sb.setFrontDist(frontDistanceFeature);
        sb.setFrontTtc(frontTtcFeature);
    } else {
        // 训练 ALP 的无前车默认值。
        sb.setHasFront(false);
        sb.setFrontAgentId(-1);
        sb.setFrontSpeed(1.0);
        sb.setFrontDist(0.0);
        sb.setFrontTtc(0.0);
    }

    if (t.hasRear) {
        double rearSpeedMps = Math.max(0.0, t.rearSpeed);
        double rearDistanceM = Math.max(0.0, t.rearDis);

        double rearDistanceFeature =
            1.0 / (
                1.0 + Math.exp((rearDistanceM - 20.0) / 3.0)
            );

        sb.setHasRear(true);
        sb.setRearAgentId(t.rear_id);
        sb.setRearSpeed(rearSpeedMps / 15.0);
        sb.setRearDist(rearDistanceFeature);
    } else {
        sb.setHasRear(false);
        sb.setRearAgentId(-1);
        sb.setRearSpeed(0.0);
        sb.setRearDist(0.0);
    }
}

// ============================================================
// 4. 冲突车辆特征
// ============================================================
if (stage >= 3) {
    int conflictCount = 0;

    if (t.conflict_id != null
        && t.conflictSpeed != null
        && t.conflictEta != null
        && t.conflictDist != null) {

        conflictCount = Math.min(
            t.conflict_id.size(),
            Math.min(
                t.conflictSpeed.size(),
                Math.min(t.conflictEta.size(), t.conflictDist.size())
            )
        );
    }

    conflictCount = Math.min(conflictCount, 3);
    sb.setHasConflict(conflictCount > 0);

    double egoConflictEtaS = t.egoConflictEta;
    double egoConflictDistanceM = t.egoConflictDist;

    for (int i = 0; i < conflictCount; i++) {
        int conflictId = t.conflict_id.get(i);
        double conflictSpeedMps = t.conflictSpeed.get(i);
        double conflictEtaS = t.conflictEta.get(i);
        double conflictDistanceM = t.conflictDist.get(i);

        if (!Double.isFinite(conflictSpeedMps) || conflictSpeedMps < 0.0) {
            conflictSpeedMps = 0.0;
        }
        if (!Double.isFinite(conflictEtaS)) conflictEtaS = 9999.0;
        if (!Double.isFinite(conflictDistanceM)) conflictDistanceM = 9999.0;

        double conflictSpeedFeature = conflictSpeedMps / 15.0;
        double relativeSpeedFeature =
            (egoSpeedMps - conflictSpeedMps) / 15.0;

        double conflictEtaFeature =
            1.0 / (
                1.0 + Math.exp((conflictEtaS - 6.0) / 1.5)
            );

        // 有符号：other - ego。禁止使用 Math.abs。
        double diffEtaFeature = 0.0;
        if (egoConflictEtaS < 9999.0 && conflictEtaS < 9999.0) {
            diffEtaFeature =
                Math.tanh((conflictEtaS - egoConflictEtaS) / 3.0);
        }

        // 有符号：other - ego。不能直接发送 otherDistance。
        double diffDistanceFeature = 0.0;
        if (egoConflictDistanceM < 9999.0
            && conflictDistanceM < 9999.0) {
            diffDistanceFeature =
                Math.tanh(
                    (conflictDistanceM - egoConflictDistanceM) / 20.0
                );
        }

        Fusion.grpc.ConflictVehicleInfo conflict =
            Fusion.grpc.ConflictVehicleInfo.newBuilder()
                .setAgentId(conflictId)
                .setConflictSpeed(conflictSpeedFeature)
                .setRelativeSpeed(relativeSpeedFeature)
                .setConflictEta(conflictEtaFeature)
                .setDiffEta(diffEtaFeature)
                .setDiffDist(diffDistanceFeature)
                .build();

        sb.addConflictVehicles(conflict);
    }
}

return sb.build();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Fusion.grpc.StepResponse]]></ReturnType>
					<Id>1783324511170</Id>
					<Name><![CDATA[buildSpeedStepResponse]]></Name>
					<X>1520</X><Y>-880</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[Fusion.grpc.StepResponse.Builder responseBuilder =
    Fusion.grpc.StepResponse.newBuilder();

int count = 0;

for (Truck t : trucks) {

    Fusion.grpc.AgentState agentState =
        Fusion.grpc.AgentState.newBuilder()
            .setAgentId("agent_" + t.truckId)
            .setObservation(buildSpeedState(t, 3))
            .setReward(0)
            .setTerminated(false)
            .setTruncated(false)

            .putInfo("truck_id", String.valueOf(t.truckId))
            .putInfo("speed", String.valueOf(t.egoSpeed))
            .putInfo("cmd_accel", String.valueOf(t.cmdAccel))

            .putInfo("target_road_node", String.valueOf(t.targetNodeName))
            .putInfo("dist_to_int", String.valueOf(t.disToInt))
            .putInfo("tta_ego", String.valueOf(t.tta))

            .putInfo("has_front", String.valueOf(t.hasFront))
            .putInfo("front_id", String.valueOf(t.front_id))
            .putInfo("front_dist", String.valueOf(t.frontDis))
            .putInfo("has_rear", String.valueOf(t.hasRear))
            .putInfo("rear_id", String.valueOf(t.rear_id))
            .putInfo("rear_dist", String.valueOf(t.rearDis))

            .putInfo("conflict_node", String.valueOf(t.conflictNodeKey))
            .putInfo("ego_conflict_eta", String.valueOf(t.egoConflictEta))
            .putInfo("ego_conflict_dist", String.valueOf(t.egoConflictDist))
            .putInfo("conflict_count", String.valueOf(
                t.conflict_id == null ? 0 : t.conflict_id.size()
            ))

            .build();

    responseBuilder.addAgents(agentState);
    count++;
}

responseBuilder.setGlobalDone(false);
responseBuilder.putGlobalInfo("time", String.valueOf(time()));
responseBuilder.putGlobalInfo("num_trucks", String.valueOf(trucks.size()));
responseBuilder.putGlobalInfo("agent_count", String.valueOf(count));
responseBuilder.putGlobalInfo("mode", "full_state_test_stage_3");

traceln("[SpeedControl] buildSpeedStepResponse agents=" + count);

return responseBuilder.build();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783324557206</Id>
					<Name><![CDATA[calculateSpeedReward]]></Name>
					<X>1520</X><Y>-840</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[Truck]]></Type>
					</Parameter>
					<Body><![CDATA[double reward = 0;

try {
    if (t.is_collision) {
        reward -= 10.0;
    }
} catch (Exception e) {}

try {
    if (t.is_arrived || t.agentDone) {
        reward += 1.0;
    }
} catch (Exception e) {}

try {
    if (t.hasFront  && t.frontDis > 0 && t.frontDis < 10) {
        reward -= (10.0 - t.frontDis) * 0.1;
    }
} catch (Exception e) {}

try {
    reward -= Math.abs(t.cmdAccel) * 0.01;
} catch (Exception e) {}

return reward;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Fusion.grpc.ObservationDict]]></ReturnType>
					<Id>1783325271610</Id>
					<Name><![CDATA[get_all_observations_following]]></Name>
					<X>1520</X><Y>-800</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return buildSpeedObservations(2);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[Fusion.grpc.ObservationDict]]></ReturnType>
					<Id>1783325312692</Id>
					<Name><![CDATA[get_all_observations]]></Name>
					<X>1520</X><Y>-760</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[return buildSpeedObservations(3);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783325699082</Id>
					<Name><![CDATA[updateFrontRearVehicles]]></Name>
					<X>1520</X><Y>-720</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[final boolean debugFrontRear = false;

// 1. 清空上一周期状态。这里保存物理量；归一化统一放在 buildSpeedState。
for (Truck t : trucks) {
    if (t == null) continue;

    t.hasFront = false;
    t.front_id = -1;
    t.frontSpeed = 0.0;
    t.frontDis = 9999.0;
    t.frontTtc = 9999.0;

    t.hasRear = false;
    t.rear_id = -1;
    t.rearSpeed = 0.0;
    t.rearDis = 9999.0;

    t.currentLaneKey = "";
    t.currentDirection = 0;
    t.laneProgress = 0.0;
}

// 2. 按同一有向路段分组。
java.util.HashMap<String, java.util.ArrayList<Truck>> laneGroups =
    new java.util.HashMap<String, java.util.ArrayList<Truck>>();

for (Truck t : trucks) {
    if (t == null || t.currentSegment == null) continue;

    String laneKey = t.currentSegment.getLaneKey();
    if (laneKey == null || laneKey.length() == 0) continue;

    t.currentLaneKey = laneKey;
    t.currentDirection = t.currentSegment.direction;

    // 米：从当前有向路段起点开始的纵向进度。
    t.laneProgress =
        t.currentSegment.calcProgressFromRemainingDistance(t.disToInt);

    java.util.ArrayList<Truck> lane = laneGroups.get(laneKey);
    if (lane == null) {
        lane = new java.util.ArrayList<Truck>();
        laneGroups.put(laneKey, lane);
    }
    lane.add(t);
}

// 3. 路段内按纵向进度排序。进度较大的车辆在前。
for (String laneKey : laneGroups.keySet()) {
    java.util.ArrayList<Truck> lane = laneGroups.get(laneKey);
    if (lane == null || lane.size() == 0) continue;

    java.util.Collections.sort(
        lane,
        new java.util.Comparator<Truck>() {
            @Override
            public int compare(Truck a, Truck b) {
                return Double.compare(a.laneProgress, b.laneProgress);
            }
        }
    );

    for (int i = 0; i < lane.size(); i++) {
        Truck ego = lane.get(i);
        Truck rear = i > 0 ? lane.get(i - 1) : null;
        Truck front = i < lane.size() - 1 ? lane.get(i + 1) : null;

        if (front != null) {
            double distance = front.laneProgress - ego.laneProgress;
            if (!Double.isFinite(distance) || distance < 0.0) distance = 0.0;

            ego.hasFront = true;
            ego.front_id = front.truckId;
            ego.frontSpeed = Math.max(0.0, front.egoSpeed); // m/s
            ego.frontDis = distance;                        // m

            double closingSpeed = ego.egoSpeed - front.egoSpeed;
            ego.frontTtc = closingSpeed > 0.1
                ? distance / closingSpeed
                : 9999.0;
        }

        if (rear != null) {
            double distance = ego.laneProgress - rear.laneProgress;
            if (!Double.isFinite(distance) || distance < 0.0) distance = 0.0;

            ego.hasRear = true;
            ego.rear_id = rear.truckId;
            ego.rearSpeed = Math.max(0.0, rear.egoSpeed); // m/s
            ego.rearDis = distance;                       // m
        }

        if (debugFrontRear) {
            traceln(
                "[FrontRear] lane=" + laneKey
                + ", ego=" + ego.truckId
                + ", front=" + ego.front_id
                + ", frontDistM=" + ego.frontDis
                + ", rear=" + ego.rear_id
                + ", rearDistM=" + ego.rearDis
            );
        }
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1783325721757</Id>
					<Name><![CDATA[updateConflictVehicles]]></Name>
					<X>1520</X><Y>-680</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[final boolean debugConflict = false;
final double conflictLookAheadDist = 100.0; // 训练 ALP 使用 100 m
final int maxConflictVehicles = 3;          // proto 与局部图契约

// 1. 清空上一周期冲突状态。
for (Truck t : trucks) {
    if (t != null) clearConflictState(t);
}

java.util.HashMap<Truck, String> nodeMap =
    new java.util.HashMap<Truck, String>();
java.util.HashMap<Truck, Double> distMap =
    new java.util.HashMap<Truck, Double>();
java.util.HashMap<Truck, Double> etaMap =
    new java.util.HashMap<Truck, Double>();

// 2. 计算驶向 intersection2 的车辆到冲突节点的物理距离和 ETA。
// 原训练 ALP 只有 intDestination == 2 时产生冲突特征。
for (Truck t : trucks) {
    if (t == null || t.currentSegment == null) continue;

    String nodeKey = getTruckConflictNodeKey(t);
    if (nodeKey == null || nodeKey.length() == 0) continue;

    if (roadNodeNameToInt(nodeKey) != 2) continue;

    double distance = calcDistanceToNode(t, nodeKey);
    if (!Double.isFinite(distance)
        || distance < 0.0
        || distance > conflictLookAheadDist) {
        continue;
    }

    double speed = Math.max(0.0, t.egoSpeed);
    double eta = calcEta(distance, speed);

    if (!Double.isFinite(eta)) eta = 9999.0;

    t.conflictNodeKey = nodeKey;
    t.egoConflictDist = distance; // 原始米
    t.egoConflictEta = eta;       // 原始秒

    nodeMap.put(t, nodeKey);
    distMap.put(t, distance);
    etaMap.put(t, eta);
}

// 3. 找出来自其他有向入口、驶向同一中心路口的车辆。
for (Truck ego : trucks) {
    if (ego == null || !nodeMap.containsKey(ego)) continue;

    final String egoNode = nodeMap.get(ego);
    final double egoEta = etaMap.get(ego);

    java.util.ArrayList<Truck> candidates =
        new java.util.ArrayList<Truck>();

    for (Truck other : trucks) {
        if (other == null || other == ego || !nodeMap.containsKey(other)) {
            continue;
        }

        String otherNode = nodeMap.get(other);
        if (!egoNode.equals(otherNode)) continue;

        // 同一有向路段上的车辆属于跟驰关系，不属于交叉冲突关系。
        boolean sameDirectedSegment =
            ego.currentSegment != null
            && other.currentSegment != null
            && ego.currentSegment.isSameDirectedSegment(other.currentSegment);

        if (sameDirectedSegment) continue;

        candidates.add(other);
    }

    // proto 指定“ETA 最接近的三辆”。按物理 ETA 差稳定排序。
    java.util.Collections.sort(
        candidates,
        new java.util.Comparator<Truck>() {
            @Override
            public int compare(Truck a, Truck b) {
                double diffA = Math.abs(etaMap.get(a) - egoEta);
                double diffB = Math.abs(etaMap.get(b) - egoEta);

                int result = Double.compare(diffA, diffB);
                if (result != 0) return result;

                result = Double.compare(distMap.get(a), distMap.get(b));
                if (result != 0) return result;

                return Integer.compare(a.truckId, b.truckId);
            }
        }
    );

    int keepCount = Math.min(maxConflictVehicles, candidates.size());

    for (int i = 0; i < keepCount; i++) {
        Truck other = candidates.get(i);

        // 四个列表必须同步写入。这里全部保存原始物理量。
        ego.conflict_id.add(other.truckId);
        ego.conflictSpeed.add((float) Math.max(0.0, other.egoSpeed));
        ego.conflictEta.add((float) etaMap.get(other).doubleValue());
        ego.conflictDist.add((float) distMap.get(other).doubleValue());
    }

    if (debugConflict && keepCount > 0) {
        traceln(
            "[Conflict] ego=" + ego.truckId
            + ", node=" + egoNode
            + ", egoDistM=" + ego.egoConflictDist
            + ", egoEtaS=" + ego.egoConflictEta
            + ", ids=" + ego.conflict_id
        );
    }
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
