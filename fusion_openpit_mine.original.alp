				 	<EmbeddedIcon>false</EmbeddedIcon>				
					<Id>1776915012694</Id>
					<Name><![CDATA[button]]></Name>
					<X>430</X><Y>-730</Y>
					<Label><X>0</X><Y>-10</Y></Label>
