# Copy to a protected host file such as /etc/dispatch-center/dispatch-center.env.
# Never commit a real MQTT password.
MQTT_BROKER_URI=ssl://localhost:8883
MQTT_CLIENT_ID=dispatch-center-backend
MQTT_USERNAME=field_uplink
MQTT_PASSWORD=CHANGE_ME
MQTT_CA_FILE=/home/jinx/System1/mqtt-tls/certs/ca.crt
MQTT_ENABLED=true
MQTT_INFERENCE_TRIGGER_TOPIC=mine/sim/+/trigger/+
MQTT_DECISION_RESULT_TOPIC=mine/sim/+/result/decision/+

INFERENCE_ENABLED=true
INFERENCE_MODE=onnx
DISPATCH_ONNX_MODEL=/opt/dispatch-center/models/dispatch_ppo.onnx
SPEED_ONNX_MODEL=/opt/dispatch-center/models/speed_actor.onnx
DISPATCH_INFERENCE_HOST=127.0.0.1
DISPATCH_INFERENCE_PORT=50051
DISPATCH_INFERENCE_TIMEOUT_MS=10000
SPEED_INFERENCE_HOST=127.0.0.1
SPEED_INFERENCE_PORT=50060
SPEED_INFERENCE_TIMEOUT_MS=150
MIN_ACCELERATION_MPS2=-5.0
MAX_ACCELERATION_MPS2=3.0

DATABASE_URL=jdbc:sqlite:/opt/dispatch-center/data/dispatch-center.db
SERVER_PORT=8080
VEHICLE_STALE_MS=3000
SHOVEL_STALE_MS=3000
SIMULATION_STALE_MS=5000

SECURITY_ENABLED=true
SECURITY_SESSION_HOURS=12
# Format: username|password|role|simulationId|subjectId;...
SECURITY_BOOTSTRAP_USERS=ZNDX|123456789|DISPATCHER||
